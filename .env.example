EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server only. Never prefix these with EXPO_PUBLIC_, and never commit a real .env.
# SUPABASE_SERVICE_ROLE_KEY is used by scripts/provision-admin.mjs and the admin-accounts function.
SUPABASE_SERVICE_ROLE_KEY=
# Password for the ADMIN account. Supabase Auth stores it hashed. Do not put it in source code.
ADMIN_PASSWORD=
